# ============================================================
# Industrial Energy Efficiency Copilot
# Environment Variables — EXAMPLE FILE
# Copy this to .env and fill in your values.
# ============================================================

# -----------------------------------------------------------
# LLM Configuration
# -----------------------------------------------------------
LLM_PROVIDER=mistral

# Mistral API
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_MODEL=mistral-small-latest

# -----------------------------------------------------------
# Embedding Configuration
# -----------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# -----------------------------------------------------------
# PDF Source Files (relative to project root)
# -----------------------------------------------------------
PDF_THERMAL=bee guide - thermal utility.pdf
PDF_ELECTRICAL=bee guide - electrical utilities.pdf

# -----------------------------------------------------------
# Index / Data Paths
# -----------------------------------------------------------
DATA_DIR=data
INDEX_DIR=data/indexes
CHROMA_DIR=data/indexes/chroma
BM25_INDEX_PATH=data/indexes/bm25_index.pkl
CHUNKS_CACHE_PATH=data/indexes/chunks.jsonl

# -----------------------------------------------------------
# Retrieval Configuration
# -----------------------------------------------------------
DENSE_TOP_K=20
SPARSE_TOP_K=20
RERANK_TOP_K=8
HYBRID_ALPHA=0.6

# -----------------------------------------------------------
# Backend Server
# -----------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true
LOG_LEVEL=INFO

# -----------------------------------------------------------
# Frontend
# -----------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
